# ========================================================
# FOODGENIE - MASTER ENVIRONMENT CONFIGURATION
# ========================================================

# Backend Core Configuration
PROJECT_NAME="FOODGENIE"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-32-byte-hex-string"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL
# Development:
DATABASE_URL="sqlite:///./backend/foodgenie.db"
# Production (PostgreSQL):
# DATABASE_URL="postgresql://foodgenie_admin:db_password_here@localhost:5432/foodgenie_db"

# AI Provider Credentials
LLM_PROVIDER="openrouter"
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="nvidia/nemotron-3.5-super-vl:free"
GEMINI_API_KEY="your-gemini-api-key"
OPENAI_API_KEY="your-openai-api-key"
GNANI_API_KEY="your-gnani-api-key"
GNANI_API_KEY_ID=""
GNANI_VOICE_EMBEDDING=""

# Language Configuration
DEFAULT_LANGUAGE="en"
SUPPORTED_LANGUAGES='["en", "te", "hi", "ta", "kn"]'

# Frontend Client Base URL
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# Email Delivery Provider for Registration OTP (configure SMTP or Resend)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_EMAIL="FoodGenie <your-email@gmail.com>"
SMTP_USE_TLS=true
# Or use Resend HTTPS API instead of SMTP:
# RESEND_API_KEY="your-resend-api-key"
# RESEND_FROM_EMAIL="FoodGenie <onboarding@yourdomain.com>"
OTP_EXPIRE_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5


